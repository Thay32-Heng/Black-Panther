# Public site URL used for metadata, robots, and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Live Telemetry: "The Pulse of the Engineer" ----

# GitHub card (app/api/github)
GITHUB_USERNAME=Thay32-Heng
# Optional but recommended. A fine-grained, read-only token unlocks true
# commit counts across ALL repos and avoids the unauthenticated rate limit.
# Without it the card honestly falls back to public "pushes".
GITHUB_TOKEN=

# Now Listening card (Spotify) — leave blank to keep the card hidden.
# Setup: create a free app at https://developer.spotify.com/dashboard,
# then complete one OAuth login to mint the refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=